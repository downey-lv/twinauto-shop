{
  "name": "Twinauto Veikals",
  "short_name": "Veikals",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#1e1e2d",
  "background_color": "#1e1e2d",
  "display": "standalone",
  "start_url": "/",
  "scope": "/",
  "protocol_handlers": [
    { "protocol": "web+autoshop", "url": "/?autoshop=%s" }
  ],
  "launch_handler": { "client_mode": "navigate-existing" }
}
